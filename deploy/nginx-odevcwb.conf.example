# NOVO arquivo — NÃO edite o site/backend que já existe.
# Crie: sudo nano /etc/nginx/sites-available/odevcwb.com
# Ative: sudo ln -s /etc/nginx/sites-available/odevcwb.com /etc/nginx/sites-enabled/
#
# Ajuste os caminhos em /var/www/odevcwb/ conforme sua VPS.
# O Node do disparador roda ISOLADO na porta 3100 (não mexe no backend existente).

upstream odevcwb_disparador_api {
    server 127.0.0.1:3100;
}

server {
    listen 80;
    server_name odevcwb.com www.odevcwb.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name odevcwb.com www.odevcwb.com;

    ssl_certificate     /etc/letsencrypt/live/odevcwb.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/odevcwb.com/privkey.pem;

    client_max_body_size 4m;

    # --- Portfolio (página principal) ---
    root /var/www/odevcwb/portfolio/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- Separador PDF (100% estático) ---
    location = /separadorpdf {
        return 301 /separadorpdf/;
    }

    location /separadorpdf/ {
        alias /var/www/odevcwb/separador/dist/;
        try_files $uri $uri/ /separadorpdf/index.html;
    }

    # --- WhatsApp Links (100% estático) ---
    location = /wpp-links {
        return 301 /wpp-links/;
    }

    location /wpp-links/ {
        alias /var/www/odevcwb/wpp-links/dist/;
        try_files $uri $uri/ /wpp-links/index.html;
    }

    # --- Disparador Gmail — frontend estático ---
    location = /disparador-gmail {
        return 301 /disparador-gmail/;
    }

    location /disparador-gmail/ {
        alias /var/www/odevcwb/disparador-gmail/client/dist/;
        try_files $uri $uri/ /disparador-gmail/index.html;
    }

    # --- Disparador Gmail — API (proxy isolado, porta 3100) ---
    location /disparador-gmail/api/ {
        proxy_pass http://odevcwb_disparador_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
